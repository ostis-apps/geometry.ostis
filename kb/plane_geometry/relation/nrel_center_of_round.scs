sc_node_non_role_relation -> nrel_center_of_disk;;

nrel_center_of_disk => nrel_main_idtf:
	[центр круга*]
	(* <- lang_ru;; *);
	[center of round*]
	(*<-lang_en;;*);;

nrel_center_of_disk => nrel_idtf:
	[быть центром круга*]
	(* <- lang_ru;; *);;

nrel_center_of_disk <= nrel_definitional_domain: 
	...
	(*
	<= nrel_combination: 
		{
		concept_disk;
		concept_geometric_point
		};;
	*);;

nrel_center_of_disk <= nrel_first_domain:
	concept_disk;;		

nrel_center_of_disk <= nrel_second_domain: 
	concept_geometric_point;;

nrel_center_of_disk <- relation;;
nrel_center_of_disk <- binary_relation;;
nrel_center_of_disk <- oriented_relation;;
nrel_center_of_disk <- antireflexive_relation;;
nrel_center_of_disk <- antisymmetric_relation;;
nrel_center_of_disk <- antitransitive_relation;;



