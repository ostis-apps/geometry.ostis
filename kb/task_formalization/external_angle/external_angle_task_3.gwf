        <node type="node/const/perm/general" idtf="" shapeColor="0" id="1747686770192" parent="0" x="311.341" y="1451.11" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Внешний угол треугольника равен сумме двух внутренних углов, не смежных с ним.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="1747686773104" parent="0" x="551.341" y="1456.6" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[The external angle of a triangle is equal to the sum of two internal angles that are not adjacent to it.]]></content>
        </node>
        <node type="node/const/perm/group" idtf="lang_en" shapeColor="0" id="1747686769984" parent="0" left="0" top="0" right="53" bottom="25" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="551.282" y="1535.9" haveBus="false" idtf_pos="0">
