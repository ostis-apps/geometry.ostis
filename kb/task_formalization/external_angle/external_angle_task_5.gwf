        <node type="node/const/perm/general" idtf="" shapeColor="0" id="2723195549728" parent="0" x="1112.77" y="2344.11" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[The external angle of a triangle is equal to the sum of two internal angles that are not adjacent to it.]]></content>
        </node>
        <node type="node/const/perm/group" idtf="lang_en" shapeColor="0" id="2723254116240" parent="0" left="0" top="0" right="53" bottom="25" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="3154.95" y="2246.22" haveBus="false" idtf_pos="0">
            <content type="0" mime_type="" content_visibility="false" file_name=""/>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="2723254118112" parent="0" x="2889.91" y="2245.99" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Since the angle AOB is equal to two angles ABC, and the angle ABC is equal to two angles ABK or two angles KBC, the angle AOB is equal to four angles ABK or four angles KBC. Also, the angle AOB is the external angle of the triangle BOH and is equal to the sum of the angles OBH and OHB. Hence, the angles ABK and KBC are equal to 30°, and angle ABC is equal to 60°.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="2723254122064" parent="0" x="2892.88" y="1902.24" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Т.к. угол AOB равен двум углам ABC, а угол ABC равен двум углам ABK или двум углам KBC, то угол AOB равен четырём углам ABK или четырём углам KBC. Также, угол AOB - внешний угол треугольника BOH и равен сумме углов OBH и OHB. Отсюда, углы ABK и KBC равны 30°, а угол ABC равен 60°.]]></content>
        </node>
        <node type="node/const/perm/relation" idtf="nrel_basic_sequence" shapeColor="0" id="2723254120192" parent="0" left="0" top="0" right="123" bottom="25" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="815.119" y="1832.78" haveBus="false" idtf_pos="0">
