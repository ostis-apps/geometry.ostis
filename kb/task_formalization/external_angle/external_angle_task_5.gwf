        <node type="node/const/perm/role" idtf="rrel_1" shapeColor="0" id="2723194991328" parent="0" left="0" top="0" right="42" bottom="25" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="610.931" y="1029.65" haveBus="false" idtf_pos="1">
