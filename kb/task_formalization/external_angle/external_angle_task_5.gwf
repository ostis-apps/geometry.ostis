            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Биссектрисой угла называется луч, который выходит из вершины угла и делит его на два равных угла. ]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="2356176051664" parent="0" x="1104.36" y="1645.3" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[The bisectrix of an angle is a ray that comes out from the vertex of the angle and divides it into two equal angles.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="2356176057280" parent="0" x="2454.59" y="1462.29" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Angles ABK and KBC are equal to angle ABC divided by 2.]]></content>
