        <node type="node/const/perm/group" idtf="lang_ru" shapeColor="0" id="879857760" parent="0" left="0" top="0" right="50.5938" bottom="23" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="620.841" y="1996.45" haveBus="false" idtf_pos="0">
