        <node type="node/const/perm/general" idtf="" shapeColor="0" id="678951248" parent="0" x="322.083" y="2675.8" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[In an isosceles triangle, the height to the base coincides with the median. ]]></content>
        </node>
        <node type="node/const/perm/relation" idtf="nrel_sc_text_translation" shapeColor="0" id="678495904" parent="0" left="0" top="0" right="137.906" bottom="23" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1061.5" y="1552.83" haveBus="false" idtf_pos="0">
            <content type="0" mime_type="" content_visibility="false" file_name=""/>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="678720096" parent="0" x="401.144" y="2065.38" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[A triangle is called isosceles if it has two equal sides. The equal sides of an isosceles triangle are called lateral sides, the third side is called the base.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="678725552" parent="0" x="614.674" y="1901.81" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Треугольник называется равнобедренным, если у него две стороны равны. Равные стороны равнобедренного треугольника называются боковыми стронами, третья сторона называется основанием.]]></content>
        </node>
        <node type="node/const/perm/group" idtf="lang_ru" shapeColor="0" id="678801072" parent="0" left="0" top="0" right="50.5938" bottom="23" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="620.841" y="1996.45" haveBus="false" idtf_pos="0">
            <content type="0" mime_type="" content_visibility="false" file_name=""/>
        </node>
        <node type="node/const/perm/general" idtf="definition_of_isosceles_triangle" shapeColor="0" id="678335840" parent="0" left="0" top="0" right="178.313" bottom="23" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="326.374" y="1858.86" haveBus="false" idtf_pos="3">
            <content type="0" mime_type="" content_visibility="false" file_name=""/>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="678567456" parent="0" x="1449" y="1627.67" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Треугольник является равнобедренным. AB и AC являются боковыми сторонами треугольника, а BC является основанием.
]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="678573984" parent="0" x="1169.33" y="1767.67" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[The triangle is isosceles. AB and AC are lateral sides of the triangle and BC is the base.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="678416752" parent="0" x="1673.79" y="2909.91" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[K является серединой отрезка BC. Отрезок CK равен 4 м.]]></content>
        </node>
