        <node type="node/const/perm/general" idtf="" shapeColor="0" id="879986288" parent="0" x="1673.79" y="2909.91" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[K является серединой отрезка BC. Отрезок CK равен 4 м.]]></content>
