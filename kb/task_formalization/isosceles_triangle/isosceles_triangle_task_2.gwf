        <node type="node/const/perm/general" idtf="" shapeColor="0" id="879852144" parent="0" x="614.674" y="1901.81" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Треугольник называется равнобедренным, если у него две стороны равны. Равные стороны равнобедренного треугольника называются боковыми стронами, третья сторона называется основанием.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="879847728" parent="0" x="401.144" y="2065.38" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[A triangle is called isosceles if it has two equal sides. The equal sides of an isosceles triangle are called lateral sides, the third side is called the base.]]></content>
        </node>
        <node type="node/const/perm/relation" idtf="nrel_sc_text_translation" shapeColor="0" id="879721392" parent="0" left="0" top="0" right="137.906" bottom="23" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1061.5" y="1552.83" haveBus="false" idtf_pos="0">
