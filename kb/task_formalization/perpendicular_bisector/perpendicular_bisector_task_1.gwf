        <node type="node/const/perm/general" idtf="" shapeColor="0" id="104608550996032" parent="0" x="107.679" y="1708.88" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="false" file_name=""><![CDATA[Сумма длин всех сторон четырехугольника равна его периметру.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="104608550990208" parent="0" x="214.311" y="1699.49" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="false" file_name=""><![CDATA[The sum of all sides of a quadrilateral is equal to its perimeter.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="104608550984736" parent="0" x="1249.98" y="793.839" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[MA is equal to BM, and KB is equal to AK, since MK is a perpendicular bisector of AB. ]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="104608550976112" parent="0" x="1514.9" y="979.673" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[AM равен BM, и KB равен AK, так как MK есть серединный перпендикуляр AB.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="104608550971408" parent="0" x="153.526" y="1244.37" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="false" file_name=""><![CDATA[Любая точка серединного перпендикуляра к отрезку равноудалена от концов этого отрезка.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="104608550907152" parent="0" x="260.158" y="1235.68" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="false" file_name=""><![CDATA[Any point of a perpendicular bisector to some segment is equidistant to the ends of this segment.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="104608550897024" parent="0" x="1528.11" y="1502.2" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Периметр AMBK равен 56 см.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="104608550891792" parent="0" x="1358.19" y="1313.36" haveBus="false" idtf_pos="0">
