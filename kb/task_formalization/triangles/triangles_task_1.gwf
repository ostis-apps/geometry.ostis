            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Углы треугольника KED K, E и D равны  соответственно 30°, 90° и 60° ]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="95607738251488" parent="0" x="1070.26" y="379.289" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[If side AB is equal to side DE and side AC is equal to side DK, then side BC is equal to side EK.
]]></content>
        </node>
        <node type="node/const/perm/group" idtf="lang_en" shapeColor="0" id="95607738234592" parent="0" left="0" top="0" right="51.3125" bottom="23" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="967.303" y="232.705" haveBus="false" idtf_pos="0">
