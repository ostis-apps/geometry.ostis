        <node type="node/const/perm/general" idtf="" shapeColor="0" id="95607738228608" parent="0" x="761.644" y="229.341" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Если сторона AB равна стороне DE, а сторона AC равна стороне DK, значит сторона BC равна стороне EK.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="95607738223568" parent="0" x="-474.94" y="758.548" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Треугольники называется равными, если у них соответсвенно равны три стороны.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="95607738186320" parent="0" x="-933.733" y="755.538" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Triangles are called equal if they have three sides equal respectively.
