            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Triangles are called equal if they have three sides equal respectively.
]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="99470180885744" parent="0" x="761.644" y="229.341" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Если сторона AB равна стороне DE, а сторона AC равна стороне DK, значит сторона BC равна стороне EK.]]></content>
        </node>
        <node type="node/const/perm/group" idtf="lang_en" shapeColor="0" id="99470180872288" parent="0" left="0" top="0" right="51.3125" bottom="23" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="967.303" y="232.705" haveBus="false" idtf_pos="0">
