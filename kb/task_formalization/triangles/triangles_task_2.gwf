        <node type="node/const/perm/general" idtf="" shapeColor="0" id="108755040845040" parent="0" x="501.23" y="1331.4" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Треугольники называются равными, если у них соответсвенно равны три стороны.]]></content>
