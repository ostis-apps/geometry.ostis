theorem_isosceles_bisector => nrel_main_idtf: [Теор.(равнобедренный треугольник; биссектриса; медиана; высота*)] (*<- lang_ru;;*);;  
theorem_isosceles_bisector => nrel_main_idtf: [Th.(isosceles triangle; bisector; median; altitude*)] (*<- lang_en;;*);;

theorem_isosceles_bisector <= nrel_sc_text_translation: 
    ... 
    (* 
    -> rrel_example: 
      {
        [В равнобедренном треугольнике биссектриса, проведенная к основанию, является его медианой и высотой.] (* <- lang_ru;; *);
        [In an isosceles triangle, the bisector drawn to the base is its median and altitude.] (* <- lang_en;; *)
      };;
    *);;

theorem_isosceles_bisector <= nrel_using_constants:  
{
