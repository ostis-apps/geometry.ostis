   concept_median; 
   concept_altitude
};;

theorem_angles_to_isosceles <- statement;;

theorem_angles_to_isosceles <- rrel_theorem: isosceles_triangle;;

theorem_angles_to_isosceles => nrel_main_idtf: [Теор.(треугольник; равные углы; равнобедренность*)] (*<- lang_ru;;*);;  
theorem_angles_to_isosceles => nrel_main_idtf: [Th.(triangle; equal angles; isosceles*)] (*<- lang_en;;*);;

theorem_angles_to_isosceles <= nrel_sc_text_translation: 
    ... 
    (* 
    -> rrel_example: 
      {
        [Если в треугольнике два угла равны, то он равнобедренный.] (* <- lang_ru;; *);
        [If a triangle has two equal angles, then it is isosceles.] (* <- lang_en;; *)
      };;
    *);;

theorem_angles_to_isosceles <= nrel_using_constants:  
{
   concept_triangle; 
   concept_equal_angles; 
   concept_isosceles_triangle
};;

