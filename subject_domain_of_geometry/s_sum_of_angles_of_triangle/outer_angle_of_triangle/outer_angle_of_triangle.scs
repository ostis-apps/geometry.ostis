sc_node -> outer_angle_of_triangle;;

outer_angle_of_triangle
=> nrel_main_idtf: [§20. Внешний угол треугольника] (* <- lang_ru;;*); [§20. Outer angle of triangle] (* <- lang_en;;*);;

sc_node -> d_exterior_angle;;

d_exterior_angle <- definition;;

d_exterior_angle  
=> nrel_main_idtf: [Опр.(Внешний угол треугольника)] (* <- lang_ru;; *);  
=> nrel_main_idtf: [Def.(Exterior angle of a triangle)] (* <- lang_en;; *);;  

d_exterior_angle <= nrel_sc_text_translation:  
  ...  
  (*  
  -> rrel_example:  
{  
    [Внешним углом треугольника называется угол, смежный с его внутренним углом.]  
    (* <- lang_ru;; *);  
    [An exterior angle of a triangle is an angle adjacent to its interior angle.]  
    (* <- lang_en;; *)  
};;  
  *);;  

d_exterior_angle <= nrel_using_constants:  
  {  
    concept_angle;  
    concept_triangle;  
    concept_adjacent_angle  
  };;

outer_angle_of_triangle <- rrel_key_sc_element: d_exterior_angle;;

theorem_exterior_angle_sum <- statement;;

theorem_exterior_angle_sum <- rrel_theorem: outer_angle_of_triangle;;

theorem_exterior_angle_sum => nrel_main_idtf: [Теор.(внешний угол; треугольник; сумма углов*)] (*<- lang_ru;;*);;  
theorem_exterior_angle_sum => nrel_main_idtf: [Th.(exterior angle; triangle; angle sum*)] (*<- lang_en;;*);;

theorem_exterior_angle_sum <= nrel_sc_text_translation: 
    ... 
    (* 
    -> rrel_example: 
      {
        [Внешний угол треугольника равен сумме двух внутренних углов, не смежных с ним.] (* <- lang_ru;; *);
        [An exterior angle of a triangle is equal to the sum of the two non-adjacent interior angles.] (* <- lang_en;; *)
      };;
    *);;

theorem_exterior_angle_sum <= nrel_using_constants:  
{
   concept_exterior_angle; 
   concept_triangle; 
   concept_interior_angle
};;  