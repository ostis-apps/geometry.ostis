theorem_right_triangle_hypotenuse_angle => nrel_main_idtf: [Теор.(гипотенуза; острый угол; равенство треугольников*)] (*<- lang_ru;;*);;  
theorem_right_triangle_hypotenuse_angle => nrel_main_idtf: [Th.(hypotenuse; acute angle; triangle congruence*)] (*<- lang_en;;*);;

