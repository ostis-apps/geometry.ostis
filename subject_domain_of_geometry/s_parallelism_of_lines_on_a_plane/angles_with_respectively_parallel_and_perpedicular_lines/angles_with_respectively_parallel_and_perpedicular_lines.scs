theorem_angles_perpendicular_sides <- rrel_theorem: angles_with_respectively_parallel_and_perpedicular_lines;;

theorem_angles_perpendicular_sides => nrel_main_idtf: [Теор.(угол; перпендикулярные стороны; равенство; сумма углов*)] (*<- lang_ru;;*);;
theorem_angles_perpendicular_sides => nrel_main_idtf: [Th.(angle; perpendicular sides; equality; angle sum*)] (*<- lang_en;;*);;

theorem_angles_perpendicular_sides <= nrel_sc_text_translation: 
    ... 
    (* 
    -> rrel_example: 
      {
        [Углы с соответственно перпендикулярными сторонами или равны (если оба острые или оба тупые), или в сумме составляют 180° (если один острый, а другой тупой).] (* <- lang_ru;; *);
        [Angles with respectively perpendicular sides are either equal (if both are acute or both are obtuse) or add up to 180° (if one is acute and the other is obtuse).] (* <- lang_en;; *)
      };;
    *);;

theorem_angles_perpendicular_sides <= nrel_using_constants:  
{
   concept_angle; 
   concept_perpendicular_sides; 
   concept_equality; 
   concept_acute_angle; 
   concept_obtuse_angle
};;