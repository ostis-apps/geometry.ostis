        <node type="node/const/perm/general" idtf="theorem_about_perpendicular_bisector" shapeColor="0" id="2204873629936" parent="0" left="0" top="0" right="228" bottom="25" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="356.735" y="1154.57" haveBus="false" idtf_pos="3">
