        <node type="node/const/perm/relation" idtf="nrel_decomposition_of_action" shapeColor="0" id="2204873628688" parent="0" left="0" top="0" right="178" bottom="25" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="-43.7653" y="801.493" haveBus="false" idtf_pos="2">
