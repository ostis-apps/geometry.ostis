        <node type="node/const/perm/general" idtf="" shapeColor="0" id="1775071631280" parent="0" x="805.205" y="1459.45" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[If at the intersection of two lines their corresponding angles are equal, then the lines are parallel.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="1775071631904" parent="0" x="626.265" y="1545.72" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="false" file_name=""><![CDATA[Angles with respectively perpendicular sides are either equal (if both of them are either acute or obtuse), or their sum is equal to 180° (if one of them is acute, but the other one is obtuse).]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="1775071630656" parent="0" x="517.265" y="1553.72" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="false" file_name=""><![CDATA[Углы с соответственно перпендикулярными сторонами или равны (если оба острые или оба тупые), или в сумме составляют 180° (если один острый, а другой тупой).]]></content>
        </node>
