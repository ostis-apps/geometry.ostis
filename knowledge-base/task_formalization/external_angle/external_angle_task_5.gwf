        <node type="node/const/perm/role" idtf="rrel_1" shapeColor="0" id="93936680759824" parent="0" left="0" top="0" right="40.4688" bottom="23" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="823.611" y="1283.12" haveBus="false" idtf_pos="0">
