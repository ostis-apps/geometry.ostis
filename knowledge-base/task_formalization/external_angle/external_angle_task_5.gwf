        <node type="node/const/perm/general" idtf="" shapeColor="0" id="93936681061232" parent="0" x="1104.36" y="1645.3" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[The bisectrix of an angle is a ray that comes out from the vertex of the angle and divides it into two equal angles.]]></content>
