        <node type="node/const/perm/general" idtf="" shapeColor="0" id="93936680624064" parent="0" x="2919.8" y="2395.42" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Since the angle AOB is equal to two angles ABC, and the angle ABC is equal to two angles ABK or two angles KBC, the angle AOB is equal to four angles ABK or four angles KBC. Also, the angle AOB is the external angle of the triangle BOH and is equal to the sum of the angles OBH and OHB. Hence, the angles ABK and KBC are equal to 30°, and angle ABC is equal to 60°.]]></content>
        </node>
        <node type="node/const/perm/group" idtf="lang_en" shapeColor="0" id="93936680662976" parent="0" left="0" top="0" right="51.3125" bottom="23" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="3184.84" y="2395.65" haveBus="false" idtf_pos="0">
