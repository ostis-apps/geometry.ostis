        <node type="node/const/perm/general" idtf="" shapeColor="0" id="2503130739920" parent="0" x="1169.33" y="1767.67" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[The triangle is isosceles. AB and AC are lateral sides of the triangle and BC is the base.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="2503130741792" parent="0" x="1449" y="1627.67" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Треугольник является равнобедренным. AB и AC являются боковыми сторонами треугольника, а BC является основанием.
]]></content>
        </node>
        <node type="node/const/perm/general" idtf="definition_of_isosceles_triangle" shapeColor="0" id="2503130739088" parent="0" left="0" top="0" right="186" bottom="25" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="326.374" y="1858.86" haveBus="false" idtf_pos="3">
