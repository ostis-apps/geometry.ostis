            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[In an isosceles triangle, the height to the base coincides with the median. ]]></content>
        </node>
        <node type="node/const/perm/relation" idtf="nrel_sc_text_translation" shapeColor="0" id="879446624" parent="0" left="0" top="0" right="137.906" bottom="23" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="1061.5" y="1552.83" haveBus="false" idtf_pos="0">
