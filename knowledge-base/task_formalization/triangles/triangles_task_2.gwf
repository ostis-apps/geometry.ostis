        <node type="node/const/perm/general" idtf="" shapeColor="0" id="2448699218864" parent="0" x="-281" y="1903.8" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[In equal triangles, equal angles lie opposite equal sides, and equal sides lie opposite equal angles.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="2448699220320" parent="0" x="72.151" y="2037.73" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[В равных треугольниках против равных сторон лежат равные углы, и против равных углов лежат равные стороны.]]></content>
        </node>
