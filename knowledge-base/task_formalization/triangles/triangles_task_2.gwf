        <node type="node/const/perm/general" idtf="" shapeColor="0" id="2448700046272" parent="0" x="42.437" y="1328.39" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Triangles are called equal if they have three sides equal respectively.]]></content>
        </node>
        <node type="node/const/perm/general" idtf="" shapeColor="0" id="2448700044816" parent="0" x="501.23" y="1331.4" haveBus="false" idtf_pos="0">
            <content type="1" mime_type="content/term" content_visibility="true" file_name=""><![CDATA[Треугольники называются равными, если у них соответсвенно равны три стороны.]]></content>
        </node>
        <node type="node/const/perm/role" idtf="rrel_1" shapeColor="0" id="2448699219072" parent="0" left="0" top="0" right="42" bottom="25" textColor="164" text_angle="0" text_font="Times New Roman" font_size="10" x="-315.39" y="571.323" haveBus="false" idtf_pos="0">
