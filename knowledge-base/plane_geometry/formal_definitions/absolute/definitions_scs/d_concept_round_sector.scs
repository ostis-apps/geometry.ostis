d_concept_circular_sector <- definition;;

d_concept_circular_sector => nrel_main_idtf:
	[Опр.(круговой сектор)]
	(* <- lang_ru;; *);
	[Def.(circular sector)]
	(* <- lang_en;; *);;

d_concept_circular_sector -> rrel_key_sc_element: concept_circular_sector;;

d_concept_circular_sector <= nrel_sc_text_translation: 
	...
	(*
	-> rrel_example: 
		[Круговой сектор - часть круга, ограниченная дугой окружности и двумя радиусами, соединящими концы дуги с центром круга.]
		(* <- lang_ru;; *);	
		[A circular sector is a part of a disk bounded by a circular arc and two radii connecting the endpoints of the arc to the center of the disk.]
		(* <- lang_en;; *);;
	*);;

d_concept_circular_sector <= nrel_using_constants:
	{
	concept_disk; 
	concept_circular_arc;  
	concept_circle; 
	nrel_center_of_circle; 
	nrel_radius
	};;	
